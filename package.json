{
  "name": "dsh-purge-fork",
  "version": "1.2.1",
  "description": "DeepSeek Harness 提示词注入与清洗：可换提示词、可调宿主补丁、带「无限制模式」预设。Jailbreak and prompt cleaning for DeepSeek Harness. 承自 YuJunZhiXue/dsh-purge 与 kingcharleslzy-ai/dsh-purge。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge-fork": "bin/dsh-purge-fork.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "presets",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "README.zh-CN.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "网络安全",
    "提示词注入",
    "llm-security",
    "harness-security",
    "deepseek-harness",
    "prompt-inject",
    "instructions",
    "rules",
    "prompt-eval",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/P4rfa1t/dsh-purge-fork.git"
  },
  "homepage": "https://github.com/P4rfa1t/dsh-purge-fork#readme",
  "bugs": {
    "url": "https://github.com/P4rfa1t/dsh-purge-fork/issues"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/unrestricted.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/P4rfa1t/dsh-purge-fork/archive/refs/heads/master.tar.gz",
      "zip": "https://github.com/P4rfa1t/dsh-purge-fork/archive/refs/heads/master.zip",
      "git": "https://github.com/P4rfa1t/dsh-purge-fork.git"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.1-rc.2"
}
